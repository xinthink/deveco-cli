{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "proper-lockfile"]
  },
  "include": ["src/**/*", "mcp/src-server/**/*", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "deveco-cli",
  "version": "0.0.1",
  "description": "HarmonyOS application development command line tool",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deveco": "./dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "license": "license-checker-rseidelsohn --json --out THIRD-PARTY-LICENSES",
    "prepublishOnly": "npm run lint && npm run license && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "harmonyos",
    "deveco",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.16.0",
    "colorette": "^2.0.20",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "json5": "^2.2.3",
    "ora": "^9.4.0",
    "regedit": "^5.1.4",
    "string-similarity-js": "^2.1.4"
  }
}
